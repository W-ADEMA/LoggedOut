{
	"schemaVersion": 1,
	"id": "loggedout",
	"version": "${version}",
	"name": "Logged Out",
	"description": "This mod logs the coords of your last logout, and puts them on your title screen",
	"authors": [
		"WADEMA"
	],
	"contact": {
		"homepage": "https://modrinth.com/mod/logged-out",
		"issues": "https://github.com/W-ADEMA/LoggedOut",
		"sources": "https://github.com/W-ADEMA/LoggedOut"
	},
	"license": "CC0-1.0",
	"icon": "assets/loggedout/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.wadema.loggedout.LoggedOut"
		],
		"client": [
			"com.wadema.loggedout.client.LoggedOutClient"
		]
	},
	"mixins": [
		"loggedout.mixins.json",
		{
			"config": "loggedout.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": "~26.2",
		"java": ">=25",
		"fabric-api": "*"
	}
}